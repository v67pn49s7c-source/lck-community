{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/*.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/schedule-sync",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/leaguepedia",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/match/:id",
      "destination": "/api/match?id=:id"
    },
    {
      "source": "/calendar/lck.ics",
      "destination": "/api/calendar"
    },
    {
      "source": "/calendar/:team.ics",
      "destination": "/api/calendar?team=:team"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/og/match/:id",
      "destination": "/api/og?kind=match&id=:id"
    },
    {
      "source": "/og/race",
      "destination": "/api/og?kind=race"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(admin|my|write|login).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
